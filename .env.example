# URL pública usada pelo Astro Sitemap/SEO
PUBLIC_SITE_URL=https://dantaspousada.chatwoot.space
SITE_URL=https://dantaspousada.chatwoot.space

# Cloudflare R2/S3 compatível
# Não coloque segredos reais no repositório. Configure estes valores no Coolify.
R2_REGION=auto
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=dantas-pousada
R2_PUBLIC_URL=https://<public-r2-domain>
R2_ACCESS_KEY_ID=<configure-no-coolify>
R2_SECRET_ACCESS_KEY=<configure-no-coolify>
