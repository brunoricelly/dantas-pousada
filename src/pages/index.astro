---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import MediaCarousel from '@/components/MediaCarousel.astro';
import InstagramShowcase from '@/components/InstagramShowcase.astro';
import { highlights, site } from '@/data/site';
---
<BaseLayout
  title="Dantas Pousada em Quixadá | Conforto no Centro"
  description="Reserve sua hospedagem na Dantas Pousada em Quixadá-CE. Localização central, quartos funcionais e atendimento rápido pelo WhatsApp."
>
  <Hero />

  <section class="py-20">
    <div class="container-page grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      {highlights.map((item) => (
        <div class="card p-7">
          <div class="text-3xl">✦</div>
          <h2 class="mt-5 text-xl font-black text-dantas-navy">{item}</h2>
        </div>
      ))}
    </div>
  </section>

  <section id="acomodacoes" class="bg-slate-50 py-20">
    <div class="container-page grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
      <div>
        <span class="eyebrow">Acomodações</span>
        <h2 class="section-title mt-5">Quartos simples, práticos e pensados para uma estadia tranquila.</h2>
        <p class="mt-5 text-lg leading-8 text-slate-600">
          Ideal para quem precisa ficar perto do centro de Quixadá, com fácil acesso a comércio, serviços e rotas para os principais pontos turísticos da região.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="btn-primary">Consultar disponibilidade</a>
          <a href={site.mapUrl} target="_blank" rel="noreferrer" class="btn-secondary">Abrir no mapa</a>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['Descanso', 'Ambientes para relaxar depois do trabalho, passeio ou viagem.'],
          ['Localização', 'Endereço central na Rua Francisco Enéas de Lima, 1891A.'],
          ['Atendimento', 'Contato direto para tirar dúvidas e combinar sua reserva.'],
          ['Quixadá', 'Base prática para conhecer monólitos, trilhas, igrejas e a cultura local.'],
        ].map(([title, text]) => (
          <div class="rounded-[2rem] border border-slate-200 bg-white p-7 shadow-sm">
            <h3 class="text-2xl font-black text-dantas-blue">{title}</h3>
            <p class="mt-3 leading-7 text-slate-600">{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <MediaCarousel />
  <InstagramShowcase />

  <section class="bg-dantas-navy py-20 text-white">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
      <div>
        <span class="eyebrow !border-white/15 !bg-white/10 !text-white">Reserve agora</span>
        <h2 class="mt-5 max-w-4xl text-4xl font-black tracking-tight sm:text-5xl">Vai para Quixadá? Fale com a Dantas Pousada e consulte sua diária.</h2>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-blue-100">Atendimento rápido pelo WhatsApp para informar datas, quantidade de pessoas e necessidades da sua estadia.</p>
      </div>
      <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="inline-flex rounded-full bg-white px-8 py-4 font-black text-dantas-red shadow-soft transition hover:-translate-y-1">Chamar no WhatsApp</a>
    </div>
  </section>
</BaseLayout>
