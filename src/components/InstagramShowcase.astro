---
import { instagramPosts } from '@/data/site';
---
<section class="py-20">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-[.82fr_1.18fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <span class="eyebrow">Conteúdo público</span>
        <h2 class="section-title mt-5">Vídeos e posts recentes da Dantas Pousada.</h2>
        <p class="mt-4 text-lg leading-8 text-slate-600">
          O Instagram limita a captura direta de vídeos sem login/API. Por isso, o site usa links públicos em cards elegantes para abrir os reels/posts oficiais em nova aba.
        </p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {instagramPosts.map((url, index) => (
          <a href={url} target="_blank" rel="noreferrer" class="group card overflow-hidden p-0 transition hover:-translate-y-1">
            <div class="aspect-[4/5] bg-gradient-to-br from-dantas-red via-fuchsia-600 to-dantas-blue p-6 text-white">
              <div class="flex h-full flex-col justify-between rounded-[1.5rem] border border-white/25 bg-white/10 p-6 backdrop-blur-sm">
                <div>
                  <div class="text-sm font-bold uppercase tracking-[0.24em] text-white/75">Instagram</div>
                  <h3 class="mt-5 text-3xl font-black">Post público #{index + 1}</h3>
                  <p class="mt-3 text-white/85">Abrir foto/reel da Dantas Pousada no Instagram oficial.</p>
                </div>
                <span class="inline-flex w-fit rounded-full bg-white px-5 py-3 text-sm font-black text-dantas-red transition group-hover:scale-105">Ver publicação</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
