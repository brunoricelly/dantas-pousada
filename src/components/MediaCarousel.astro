---
import { gallery } from '@/data/site';

const featured = gallery.slice(0, 6);
---
<section id="galeria" class="relative overflow-hidden bg-slate-950 py-24 text-white">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(33,99,255,0.22),transparent_35%),radial-gradient(circle_at_bottom_right,rgba(237,28,36,0.18),transparent_34%)]"></div>
  <div class="container-page relative">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div class="max-w-3xl">
        <span class="eyebrow !border-white/15 !bg-white/10 !text-white">Galeria profissional</span>
        <h2 class="section-title mt-5 !text-white">Explore a pousada com fotos reais e navegação interativa.</h2>
        <p class="mt-4 text-lg leading-8 text-slate-300">
          Seleção atualizada diretamente do Google Travel, organizada para mostrar quartos, banheiros, áreas internas e detalhes da hospedagem antes da reserva.
        </p>
      </div>
      <div class="rounded-full border border-white/10 bg-white/5 px-5 py-3 text-sm font-bold text-slate-300 backdrop-blur">Arraste, clique e amplie</div>
    </div>

    <div class="mt-12 grid gap-5 lg:grid-cols-[1.2fr_.8fr]">
      <div class="relative overflow-hidden rounded-[2.3rem] border border-white/10 bg-white/5 p-3 shadow-2xl">
        <div class="relative h-[62vh] min-h-[430px] overflow-hidden rounded-[1.8rem] bg-slate-900">
          {gallery.map((item, index) => (
            <img
              src={item.src}
              alt={item.alt}
              class:list={[
                'gallery-main absolute inset-0 h-full w-full object-cover transition-all duration-700',
                index === 0 ? 'is-active opacity-100 scale-100' : 'opacity-0 scale-105'
              ]}
              data-index={index}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 flex flex-col gap-5 p-6 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p class="text-xs font-black uppercase tracking-[0.28em] text-blue-100">Dantas Pousada</p>
              <h3 id="gallery-title" class="mt-2 text-3xl font-black sm:text-4xl">{gallery[0].label}</h3>
              <p class="mt-2 max-w-xl text-sm leading-6 text-white/80">Use os botões ou miniaturas para navegar pelas fotos em alta qualidade.</p>
            </div>
            <button id="gallery-open" class="rounded-full bg-white px-5 py-3 text-sm font-black text-dantas-navy shadow-soft transition hover:-translate-y-1">Ver em tela cheia</button>
          </div>
          <button id="gallery-prev" aria-label="Foto anterior" class="absolute left-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-2xl font-black text-dantas-navy shadow-lg transition hover:scale-105">‹</button>
          <button id="gallery-next" aria-label="Próxima foto" class="absolute right-4 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/90 text-2xl font-black text-dantas-navy shadow-lg transition hover:scale-105">›</button>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
        {featured.map((item, index) => (
          <button class:list={['gallery-thumb group relative h-36 overflow-hidden rounded-[1.5rem] border bg-slate-900 text-left shadow-xl transition hover:-translate-y-1', index === 0 ? 'is-active border-white' : 'border-white/10']} data-index={index}>
            <img src={item.src} alt={item.alt} class="h-full w-full object-cover opacity-75 transition duration-500 group-hover:scale-105 group-hover:opacity-100" loading="lazy" />
            <span class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></span>
            <span class="absolute bottom-3 left-4 right-4 text-sm font-black uppercase tracking-[0.16em] text-white">{item.label}</span>
          </button>
        ))}
      </div>
    </div>

    <div class="mt-6 flex snap-x gap-4 overflow-x-auto pb-3">
      {gallery.map((item, index) => (
        <button class="gallery-strip group relative h-24 w-36 shrink-0 snap-start overflow-hidden rounded-2xl border border-white/10 bg-white/5" data-index={index} aria-label={`Abrir foto ${index + 1}`}>
          <img src={item.src} alt={item.alt} class="h-full w-full object-cover transition duration-500 group-hover:scale-110" loading="lazy" />
        </button>
      ))}
    </div>
  </div>

  <dialog id="gallery-modal" class="backdrop:bg-black/85 rounded-[2rem] bg-transparent p-0">
    <div class="relative max-h-[92vh] max-w-[94vw] overflow-hidden rounded-[2rem] bg-slate-950 p-3 shadow-2xl">
      <button id="gallery-close" class="absolute right-5 top-5 z-10 rounded-full bg-white px-4 py-2 text-sm font-black text-dantas-navy">Fechar</button>
      <img id="gallery-modal-img" src={gallery[0].src} alt={gallery[0].alt} class="max-h-[86vh] w-auto max-w-[92vw] rounded-[1.5rem] object-contain" />
    </div>
  </dialog>
</section>

<script define:vars={{ labels: gallery.map((item) => item.label), sources: gallery.map((item) => item.src), alts: gallery.map((item) => item.alt) }}>
  const mains = Array.from(document.querySelectorAll('.gallery-main'));
  const thumbs = Array.from(document.querySelectorAll('.gallery-thumb, .gallery-strip'));
  const title = document.getElementById('gallery-title');
  const modal = document.getElementById('gallery-modal');
  const modalImg = document.getElementById('gallery-modal-img');
  let current = 0;
  let timer;

  function show(index) {
    current = (index + sources.length) % sources.length;
    mains.forEach((img, i) => img.classList.toggle('is-active', i === current));
    mains.forEach((img, i) => {
      img.classList.toggle('opacity-100', i === current);
      img.classList.toggle('scale-100', i === current);
      img.classList.toggle('opacity-0', i !== current);
      img.classList.toggle('scale-105', i !== current);
    });
    thumbs.forEach((btn) => btn.classList.toggle('is-active', Number(btn.dataset.index) === current));
    if (title) title.textContent = labels[current];
    if (modalImg) {
      modalImg.src = sources[current];
      modalImg.alt = alts[current];
    }
  }

  function restart() {
    window.clearInterval(timer);
    timer = window.setInterval(() => show(current + 1), 6500);
  }

  document.getElementById('gallery-prev')?.addEventListener('click', () => { show(current - 1); restart(); });
  document.getElementById('gallery-next')?.addEventListener('click', () => { show(current + 1); restart(); });
  thumbs.forEach((btn) => btn.addEventListener('click', () => { show(Number(btn.dataset.index)); restart(); }));
  document.getElementById('gallery-open')?.addEventListener('click', () => modal?.showModal());
  document.getElementById('gallery-close')?.addEventListener('click', () => modal?.close());
  document.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
    if (event.key === 'Escape') modal?.close();
  });
  restart();
</script>

<style>
  .gallery-thumb.is-active,
  .gallery-strip.is-active {
    border-color: rgba(255,255,255,.95);
    box-shadow: 0 0 0 4px rgba(255,255,255,.1);
  }
</style>
