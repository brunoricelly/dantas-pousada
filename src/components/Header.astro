---
import { navigation, site } from '@/data/site';

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/82 text-white backdrop-blur-xl">
  <div class="container-page flex h-20 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-3" aria-label="Dantas Pousada - início">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-dantas-orange via-dantas-red to-dantas-blue text-2xl font-black text-white shadow-glow transition group-hover:scale-105">D</div>

      <div class="leading-tight">
        <div class="text-lg font-black uppercase tracking-tight text-white">Dantas Pousada</div>
        <div class="text-[11px] font-bold uppercase tracking-[0.22em] text-dantas-orange">Conforto em Quixadá</div>
      </div>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navegação principal">
      {navigation.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-4 py-2 text-sm font-bold transition',
            path === item.href || (item.href !== '/' && path.startsWith(item.href))
              ? 'bg-dantas-orange text-white shadow-glow'
              : 'text-slate-200 hover:bg-white/10 hover:text-dantas-orange',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <a href={site.instagram} target="_blank" rel="noreferrer" class="btn-secondary">Instagram</a>
      <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="btn-primary">Reservar</a>
    </div>

    <details class="lg:hidden">
      <summary class="cursor-pointer rounded-full border border-white/15 bg-white/10 px-4 py-2 text-sm font-bold text-white">Menu</summary>
      <div class="absolute left-4 right-4 top-20 rounded-3xl border border-white/10 bg-slate-950/95 p-4 shadow-glow backdrop-blur-xl">
        {navigation.map((item) => <a href={item.href} class="block rounded-2xl px-4 py-3 font-bold text-slate-100 hover:bg-white/10 hover:text-dantas-orange">{item.label}</a>)}
        <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="mt-2 block rounded-2xl bg-gradient-to-r from-dantas-orange to-dantas-red px-4 py-3 font-bold text-white">Reservar pelo WhatsApp</a>
      </div>
    </details>
  </div>
</header>
