---
import { featuredVideo, gallery, site } from '@/data/site';
const heroImages = gallery.slice(0, 4);
---
<section id="inicio" class="relative isolate overflow-hidden bg-futuristic-radial text-white">
  <div class="absolute inset-0 opacity-45 bg-[linear-gradient(rgba(255,255,255,.06)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.06)_1px,transparent_1px)] bg-[size:54px_54px]"></div>
  <div class="absolute -left-28 top-10 h-96 w-96 rounded-full bg-dantas-orange/25 blur-3xl"></div>
  <div class="absolute right-0 top-28 h-[28rem] w-[28rem] rounded-full bg-dantas-blue/35 blur-3xl"></div>
  <div class="absolute bottom-0 left-1/3 h-80 w-80 rounded-full bg-dantas-red/25 blur-3xl"></div>

  <div class="container-page relative z-10 grid min-h-[820px] items-center gap-12 py-20 lg:grid-cols-[.92fr_1.08fr] lg:py-28">
    <div>
      <span class="eyebrow !border-white/15 !bg-white/10 !text-orange-100 backdrop-blur-xl">Pousada no Centro de Quixadá · CE</span>
      <h1 class="mt-6 max-w-4xl text-5xl font-black leading-[0.92] tracking-tight text-white sm:text-6xl lg:text-7xl">
        Hospedagem acolhedora com experiência visual em alta resolução.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-200">
        A Dantas Pousada combina localização central, atendimento próximo e ambientes funcionais para quem vem a trabalho, passeio ou aventura pelo Sertão Central.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="btn-primary">Reservar pelo WhatsApp</a>
        <a href="#video-destaque" class="btn-glass">Assistir vídeo em destaque</a>
      </div>
      <div class="mt-10 grid max-w-2xl grid-cols-3 gap-3">
        <div class="glass-stat"><strong class="block text-3xl text-dantas-orange">5.0</strong><span>avaliação pública</span></div>
        <div class="glass-stat"><strong class="block text-3xl text-sky-200">Centro</strong><span>localização estratégica</span></div>
        <div class="glass-stat"><strong class="block text-3xl text-red-200">24h</strong><span>consulta rápida online</span></div>
      </div>
    </div>

    <div id="video-destaque" class="relative">
      <div class="absolute -inset-5 rounded-[2.75rem] bg-gradient-to-br from-dantas-orange/50 via-dantas-blue/35 to-dantas-red/45 blur-2xl"></div>
      <div class="card-neon relative overflow-hidden p-3">
        <div class="relative h-[620px] overflow-hidden rounded-[2rem] bg-slate-950">
          <video
            class="h-full w-full object-cover"
            src={featuredVideo.src}
            poster={featuredVideo.poster}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Vídeo em alta resolução da Dantas Pousada"
          ></video>
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/85 via-slate-950/20 to-transparent"></div>
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_15%_15%,rgba(255,122,0,.28),transparent_32%),radial-gradient(circle_at_85%_15%,rgba(0,174,239,.24),transparent_34%)]"></div>
          <div class="absolute left-6 top-6 rounded-full border border-white/15 bg-black/35 px-4 py-2 text-xs font-black uppercase tracking-[0.22em] text-orange-100 backdrop-blur-xl">
            {featuredVideo.label}
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-white">
            <p class="text-sm font-bold uppercase tracking-[0.24em] text-orange-100">Dantas Pousada</p>
            <h2 class="mt-3 text-4xl font-black">{featuredVideo.title}</h2>
            <p class="mt-3 max-w-xl text-white/85">{featuredVideo.description}</p>
          </div>
        </div>
      </div>
      <div class="mt-4 grid grid-cols-4 gap-3">
        {heroImages.map((item) => (
          <img src={item.src} alt={item.alt} class="h-24 rounded-2xl border border-white/10 object-cover shadow-glow" loading="eager" />
        ))}
      </div>
    </div>
  </div>
</section>
