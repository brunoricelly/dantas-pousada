---
import { gallery, site } from '@/data/site';
const heroImages = gallery.slice(0, 4);
---
<section id="inicio" class="relative overflow-hidden bg-brand-radial">
  <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-white/80 to-transparent"></div>
  <div class="container-page grid min-h-[760px] items-center gap-12 py-16 lg:grid-cols-[1.02fr_.98fr] lg:py-24">
    <div class="relative z-10">
      <span class="eyebrow">Pousada no Centro de Quixadá · CE</span>
      <h1 class="mt-6 max-w-4xl text-5xl font-black leading-[0.94] tracking-tight text-dantas-navy sm:text-6xl lg:text-7xl">
        Hospedagem acolhedora para descansar bem em Quixadá.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-700">
        A Dantas Pousada combina localização central, atendimento próximo e ambientes funcionais para quem vem a trabalho, passeio ou aventura pelo Sertão Central.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={site.whatsappLink} target="_blank" rel="noreferrer" class="btn-primary">Reservar pelo WhatsApp</a>
        <a href="#galeria" class="btn-secondary">Ver fotos da pousada</a>
      </div>
      <div class="mt-10 grid max-w-2xl grid-cols-3 gap-3">
        <div class="rounded-3xl bg-white/85 p-5 shadow-sm"><strong class="block text-3xl text-dantas-blue">5.0</strong><span class="text-sm font-semibold text-slate-600">avaliação pública</span></div>
        <div class="rounded-3xl bg-white/85 p-5 shadow-sm"><strong class="block text-3xl text-dantas-red">Centro</strong><span class="text-sm font-semibold text-slate-600">localização estratégica</span></div>
        <div class="rounded-3xl bg-white/85 p-5 shadow-sm"><strong class="block text-3xl text-dantas-blue">24h</strong><span class="text-sm font-semibold text-slate-600">consulta rápida online</span></div>
      </div>
    </div>
    <div class="relative z-10">
      <div class="absolute -left-10 top-10 h-64 w-64 rounded-full bg-dantas-red/20 blur-3xl"></div>
      <div class="absolute -right-10 bottom-8 h-64 w-64 rounded-full bg-dantas-blue/20 blur-3xl"></div>
      <div class="card relative overflow-hidden p-4">
        <div class="relative h-[560px] overflow-hidden rounded-[1.75rem] bg-slate-900">
          <div class="media-slider flex h-full w-[400%] animate-hero-slide">
            {heroImages.map((item) => (
              <img src={item.src} alt={item.alt} class="h-full w-1/4 shrink-0 object-cover" loading="eager" />
            ))}
          </div>
          <div class="absolute inset-0 bg-gradient-to-t from-dantas-navy/80 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-7 text-white">
            <p class="text-sm font-bold uppercase tracking-[0.22em] text-blue-100">Dantas Pousada</p>
            <h2 class="mt-3 text-4xl font-black">Conforto no melhor ponto da cidade.</h2>
            <p class="mt-3 text-white/85">{site.address}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
